# MongoDB Connection URI (e.g. mongodb://localhost:27017/mindlex or MongoDB Atlas URI)
MONGODB_URI="mongodb://localhost:27017/mindlex"

# Gemini AI API Key for multilingual note extraction and link suggestions
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemini Model alias or specific identifier (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Client Application URL
CLIENT_URL="http://localhost:3000"

# Server Port
PORT=3000
